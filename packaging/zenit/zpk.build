package {
  name        = "blue-environment"
  version     = "0.7.0"
  arch        = ["x86_64"]
  description = "Blue Environment -- powloka desktopowa (Tauri + Svelte) dla srodowisk graficznych Linuksa"
  depends_on  = ["webkit2gtk", "gtk3", "libsoup3"]
}

recipe {
  file = "recipe.janet"
  lang = "janet"
}

release {
  repo       = "https://github.com/Zenit-Linux/own-repository"
  repo_file  = "repo/own-repository.json"
  asset_name = "blue-environment"
}
