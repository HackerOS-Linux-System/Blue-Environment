<Window x:Class="BlueConnect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blue Connect" Width="560" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Blue Connect" FontSize="26" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ScanButton" Content="Scan for devices" Click="OnScan" />
        </StackPanel>

        <!-- Shown while WE asked another device to pair and wait for its owner. -->
        <Border x:Name="OutgoingBanner" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0" Padding="14"
                CornerRadius="10" Background="{StaticResource CardBrush2}">
            <StackPanel>
                <TextBlock x:Name="OutgoingTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="OutgoingSas" FontSize="34" FontWeight="Bold" FontFamily="Consolas" Margin="0,4,0,0" />
                <TextBlock Text="Check that the other device shows the same code, then accept the request there."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

        <ListBox x:Name="DevicesList" Grid.Row="4" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Pair" Tag="{Binding Id}" Click="OnPair"
                                        Visibility="{Binding IsUnpaired, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Ping" Tag="{Binding Id}" Click="OnPing"
                                        Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Phone SMS…" Tag="{Binding Id}" Click="OnSms" Style="{StaticResource SecondaryButton}"
                                        Visibility="{Binding IsPhone, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Forget" Tag="{Binding Id}" Click="OnForget" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="FingerprintText" Grid.Row="5" Margin="0,8,0,0" FontSize="11" FontFamily="Consolas"
                   Foreground="{StaticResource MutedBrush}" />
    </Grid>
</Window>
