<Window x:Class="BlueConnect.App.PairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blue Connect — pairing request" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource BgBrush}" ShowInTaskbar="True">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SubText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="Security code" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="SasText" FontSize="42" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Pair only if this code is EXACTLY the same on the other device. If it differs, someone may be intercepting the connection." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="RejectButton" Content="Reject" Style="{StaticResource SecondaryButton}" Click="OnReject" IsCancel="True" />
            <Button x:Name="AcceptButton" Content="Codes match — pair" Margin="0" Click="OnAccept" IsDefault="False" />
        </StackPanel>
    </StackPanel>
</Window>
