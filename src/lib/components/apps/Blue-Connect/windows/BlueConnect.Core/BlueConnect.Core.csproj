<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Blue Connect protocol core. Deliberately UI-free and platform-neutral
    (plain net8.0, no NuGet packages) so it builds and is self-tested on any
    OS; the Windows app (../BlueConnect.App) only adds the WPF/tray UI.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>BlueConnect.Core</RootNamespace>
    <AssemblyName>BlueConnect.Core</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
